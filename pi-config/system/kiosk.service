[Unit]
Description=Serigrafia operator kiosk (cage + chromium)
After=systemd-user-sessions.service nginx.service moonraker.service getty@tty1.service
Wants=nginx.service moonraker.service
Conflicts=getty@tty1.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=aspe
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=XDG_SESSION_TYPE=wayland
ExecStartPre=/usr/local/bin/kiosk-wait.sh
ExecStart=/usr/bin/cage -- /usr/local/bin/kiosk-chromium.sh
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target