# Tema de arranque de la máquina de serigrafía.
#
# Una sola imagen fija y centrada, sin animación, barras de progreso ni
# mensajes del sistema.
#
# La imagen mide 1024x600, igual que el monitor, así que se dibuja píxel a
# píxel. Con otra resolución queda centrada sobre fondo negro; no se escala a
# propósito, porque escalar una imagen de marca la vuelve borrosa.

Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

imagen = Image("splash.png");
sprite = Sprite(imagen);
sprite.SetX(Window.GetWidth()  / 2 - imagen.GetWidth()  / 2);
sprite.SetY(Window.GetHeight() / 2 - imagen.GetHeight() / 2);
sprite.SetZ(0);
